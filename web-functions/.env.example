## Copy to .env.local for `next dev`. In production, set these as
## Environment Variables in the Vercel dashboard instead.

# Firebase service account (Firebase Console → Project Settings → Service Accounts → Generate new private key)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# Razorpay (Dashboard → Settings → API Keys / Webhooks)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# FinResolver's own Anthropic key — funds Pro users' Advisor usage
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxx

# Origin allowed to call these endpoints (CORS)
ALLOWED_ORIGIN=https://finresolver.in
